# Spotify-App-Zugangsdaten (https://developer.spotify.com/dashboard).
# Die Redirect-URI muss exakt so auch im Dashboard der App eingetragen sein.
SPOTIPY_CLIENT_ID=your-client-id
SPOTIPY_CLIENT_SECRET=your-client-secret
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Optional: statischer Web-Server (Defaults: 0.0.0.0, 15002, public/)
# HOST=0.0.0.0
# PORT=15002
# SERVE_PATH=public
